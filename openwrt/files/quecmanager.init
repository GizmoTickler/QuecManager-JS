#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/node
APP_DIR=/www/quecmanager
PIDFILE=/var/run/quecmanager.pid

start_service() {
	local enabled
	config_load 'quecmanager'
	config_get_bool enabled config 'enabled' '1'

	[ "$enabled" -eq 1 ] || {
		echo "QuecManager is disabled in /etc/config/quecmanager"
		return 1
	}

	procd_open_instance quecmanager
	procd_set_param command $PROG $APP_DIR/node_modules/.bin/next start
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile $PIDFILE
	procd_set_param env NODE_ENV=production
	procd_set_param env PORT=3000
	procd_set_param env HOSTNAME=0.0.0.0
	procd_close_instance
}

stop_service() {
	# Kill any running instances
	pkill -f "next start" || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "quecmanager"
}
